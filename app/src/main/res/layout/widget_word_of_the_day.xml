<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_notification"
            android:tint="#8C80FF"
            android:contentDescription="Word Drop Icon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="WORD OF THE DAY"
            android:textColor="#8C80FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_difficulty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_background"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="Intermediate"
            android:textColor="#4DDCC6"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Word -->
    <TextView
        android:id="@+id/widget_word_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="SERENDIPITY"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Pronunciation -->
    <TextView
        android:id="@+id/widget_pronunciation_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="/ˌser.ənˈdɪp.ə.ti/"
        android:textColor="#9E94FF"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Meaning / Definition -->
    <TextView
        android:id="@+id/widget_definition_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="The occurrence of events by chance in a happy or beneficial way."
        android:textColor="#D1CEE2"
        android:textSize="12sp" />

    <!-- Bottom Action Cue -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tap to learn &amp; practice →"
        android:textColor="#7C7896"
        android:textSize="10sp" />

</LinearLayout>
